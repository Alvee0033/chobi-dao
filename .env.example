# ==============================================================================
# CHOBI DAO - LOCAL & COOLIFY DEPLOYMENT CONFIGURATION
# ==============================================================================

# Public Host / Domain URLs (Set in Coolify / Reverse Proxy)
# Example for Fahad Coolify:
# APP_BASE_URL=https://chobi.yourdomain.com
# API_BASE_URL=https://api-chobi.yourdomain.com
# NEXT_PUBLIC_API_URL=https://api-chobi.yourdomain.com
# S3_PUBLIC_ENDPOINT=https://s3-chobi.yourdomain.com
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
S3_PUBLIC_ENDPOINT=http://localhost:9000

# PostgreSQL Database (pgvector enabled)
POSTGRES_USER=chobi
POSTGRES_PASSWORD=chobipassword123_change_in_production
POSTGRES_DB=chobi_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Local MinIO Storage Bucket
MINIO_ROOT_USER=chobiadmin
MINIO_ROOT_PASSWORD=chobiadminsecret123_change_in_prod
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=chobi-photos

# Security JWT Secrets (Set long random strings in production)
JWT_ACCESS_SECRET=chobi_super_jwt_secret_key_2026_xyz
JWT_REFRESH_SECRET=chobi_super_refresh_secret_key_2026_xyz
LIVENESS_TOKEN_SECRET=chobi_liveness_secret_key_2026
SEARCH_SESSION_SECRET=chobi_search_secret_key_2026

# Ports
API_GATEWAY_PORT=3001
WEB_PORT=3000
AI_SERVICE_PORT=8000
