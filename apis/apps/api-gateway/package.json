{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'npx nest build --watch & while [ ! -f dist/apps/api-gateway/src/main.js ]; do sleep 1; done; node --watch dist/apps/api-gateway/src/main.js'",
    "build": "prisma generate --schema=./prisma/schema.prisma && nest build",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "start": "node dist/apps/api-gateway/src/main.js",
    "lint": "echo 'no lint'",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config ./test/jest.integration.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1053.0",
    "@aws-sdk/client-s3": "^3.803.0",
    "@aws-sdk/s3-request-presigner": "^3.803.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^9.1.3",
    "@framefind/shared-contracts": "file:vendor/shared-contracts",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "googleapis": "^172.0.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "stripe": "^18.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.17.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
